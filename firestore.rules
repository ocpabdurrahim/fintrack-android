rules_version = '2';

// FinTrack's cloud is private: one owner account, whose records live under
// users/{uid}. Any other account that signs in is refused everything, and the
// apps sign it out again.
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner's Google account, plus the account the tests use. A real
    // Firebase sign-in can't get the test ID: sign-ups get random IDs, and only
    // the project's owner could create one with a chosen ID. It exists only in
    // the local emulators.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && uid in ['0sIRFAzFKScXceTRpNZfVUPNYDb2', 'fintrack-test-owner'];
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{id} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && collection in ['accounts', 'categories', 'transactions', 'budgets', 'recurring'];
      }
    }
  }
}
